<Window x:Class="WpfBookstore.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:local="clr-namespace:WpfBookstore.Views"
        xmlns:viewmodels="clr-namespace:WpfBookstore.ViewModels"
        mc:Ignorable="d"
        Title="Bookstore" Height="520" Width="800">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadAllBooksCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <StackPanel>
        <Expander Header="Filter" Margin="10" IsExpanded="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="1*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Target="{Binding ElementName=TitleFilterTextBox}" Content="Title" HorizontalAlignment="Left" VerticalAlignment="Center" />
                <TextBox x:Name="TitleFilterTextBox" Grid.Row="0" Grid.Column="1" Text="{Binding Filter.Title, Mode=TwoWay}" HorizontalAlignment="Left" Width="200" Margin="5" />
                <Label Grid.Row="0" Grid.Column="2" Target="{Binding ElementName=AuthorFilterTextBox}" Content="Author" HorizontalAlignment="Left" VerticalAlignment="Center" />
                <TextBox x:Name="AuthorFilterTextBox" Grid.Row="0" Grid.Column="3" Text="{Binding Filter.Author, Mode=TwoWay}" HorizontalAlignment="Left" Width="200" Margin="5" />

                <Label Grid.Row="1" Grid.Column="0" Target="{Binding ElementName=YearFilterTextBox}" Content="Year" HorizontalAlignment="Left" VerticalAlignment="Center" />
                <TextBox x:Name="YearFilterTextBox" Grid.Row="1" Grid.Column="1" Text="{Binding Filter.Year, Mode=TwoWay}" HorizontalAlignment="Left" Width="200" Margin="5" />
                <Label Grid.Row="1" Grid.Column="2" Target="{Binding ElementName=GenreFilterTextBox}" Content="Genre" HorizontalAlignment="Left" VerticalAlignment="Center" />
                <TextBox x:Name="GenreFilterTextBox" Grid.Row="1" Grid.Column="3" Text="{Binding Filter.Genre, Mode=TwoWay}" HorizontalAlignment="Left" Width="200" Margin="5" />

                <Label Grid.Row="2" Grid.Column="0" Target="{Binding ElementName=ISBNFilterTextBox}" Content="ISBN" HorizontalAlignment="Left" VerticalAlignment="Center" />
                <TextBox x:Name="ISBNFilterTextBox" Grid.Row="2" Grid.Column="1" Text="{Binding Filter.ISBN, Mode=TwoWay}" HorizontalAlignment="Left" Width="200" Margin="5" />
                <Label Grid.Row="2" Grid.Column="2" Target="{Binding ElementName=PublisherFilterTextBox}" Content="Publisher" HorizontalAlignment="Left" VerticalAlignment="Center" />
                <TextBox x:Name="PublisherFilterTextBox" Grid.Row="2" Grid.Column="3" Text="{Binding Filter.Publisher, Mode=TwoWay}" HorizontalAlignment="Left" Width="200" Margin="5" />

                <Label Grid.Row="3" Grid.Column="0" Target="{Binding ElementName=PagesFilterTextBox}" Content="Pages" HorizontalAlignment="Left" VerticalAlignment="Center" />
                <TextBox x:Name="PagesFilterTextBox" Grid.Row="3" Grid.Column="1" Text="{Binding Filter.Pages, Mode=TwoWay}" HorizontalAlignment="Left" Width="200" Margin="5" />
                <Label Grid.Row="3" Grid.Column="2" Target="{Binding ElementName=PriceFilterTextBox}" Content="Price" HorizontalAlignment="Left" VerticalAlignment="Center" />
                <TextBox x:Name="PriceFilterTextBox" Grid.Row="3" Grid.Column="3" Text="{Binding Filter.Price, Mode=TwoWay}" HorizontalAlignment="Left" Width="200" Margin="5" />

                <Label Grid.Row="4" Grid.Column="0" Target="{Binding ElementName=QuantityInStockFilterTextBox}" Content="Quantity In Stock" HorizontalAlignment="Left" VerticalAlignment="Center" />
                <TextBox x:Name="QuantityInStockFilterTextBox" Grid.Row="4" Grid.Column="1" Text="{Binding Filter.QuantityInStock, Mode=TwoWay}" HorizontalAlignment="Left" Width="200" Margin="5" />

                <StackPanel Grid.Row="5" Grid.ColumnSpan="4" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Command="{Binding ApplyFilterCommand}" Content="Apply" Height="20" Width="80" Margin="5" />
                    <Button Command="{Binding ResetFilterCommand}" Content="Reset" Height="20" Width="80" Margin="5" />
                </StackPanel>
            </Grid>
        </Expander>
        <StackPanel Margin="10">
            <ToolBar>
                <Button Command="{Binding AddBookCommand}" Content="Add" ToolTip="Add a book" />
                <Button Command="{Binding EditSelectedBookCommand}" Content="Edit Selected" ToolTip="Edit the sekected book" />
                <Button Command="{Binding RemoveSelectedBookCommand}" Content="Remove Selected" ToolTip="Remove the selected book" />
                <Separator />
                <Button Content="&lt;" ToolTip="First Page" Command="{Binding FirstPageCommand}" />
                <Button Content="&lt;&lt;" ToolTip="Previous Page" Command="{Binding PreviousPageCommand}" />
                <TextBlock VerticalAlignment="Center">
                    <Run Text="Page " />
                    <Run Text="{Binding CurrentPage}" />
                    <Run Text=" of " />
                    <Run Text="{Binding TotalPages}" />
                </TextBlock>
                <Button Content="&gt;&gt;" ToolTip="Next Page" Command="{Binding NextPageCommand}" />
                <Button Content="&gt;" ToolTip="Last Page" Command="{Binding LastPageCommand}" />
            </ToolBar>
            <DataGrid AutoGenerateColumns="False" ItemsSource="{Binding Books}" SelectedItem="{Binding SelectedBook, Mode=TwoWay}"
                      CanUserAddRows="False" CanUserSortColumns="False" CanUserDeleteRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding Title}" Header="Title" Width="188" IsReadOnly="True" />
                    <DataGridTextColumn Binding="{Binding Author}" Header="Author" Width="106" IsReadOnly="True" />
                    <DataGridTextColumn Binding="{Binding Year}" Header="Year" Width="43" IsReadOnly="True" />
                    <DataGridTextColumn Binding="{Binding Genre}" Header="Genre" Width="73" IsReadOnly="True" />
                    <DataGridTextColumn Binding="{Binding ISBN}" Header="ISBN" Width="86" IsReadOnly="True" />
                    <DataGridTextColumn Binding="{Binding Publisher}" Header="Publisher" Width="73" IsReadOnly="True" />
                    <DataGridTextColumn Binding="{Binding Pages}" Header="Pages" Width="SizeToHeader" IsReadOnly="True" />
                    <DataGridTextColumn Binding="{Binding Price}" Header="Price" Width="44" IsReadOnly="True" />
                    <DataGridTextColumn Binding="{Binding QuantityInStock}" Header="Quantity In Stock" Width="SizeToHeader" IsReadOnly="True" />
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </StackPanel>
</Window>
