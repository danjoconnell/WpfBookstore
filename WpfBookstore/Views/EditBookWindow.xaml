<Window x:Class="WpfBookstore.Views.EditBookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfBookstore.Views"
        xmlns:viewmodels="clr-namespace:WpfBookstore.ViewModels"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="450" Width="600" Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="32" />
            <RowDefinition Height="32" />
            <RowDefinition Height="32" />
            <RowDefinition Height="32" />
            <RowDefinition Height="32" />
            <RowDefinition Height="32" />
            <RowDefinition Height="32" />
            <RowDefinition Height="32" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Target="{Binding ElementName=TitleEditTextBox}" Content="Title" HorizontalAlignment="Left" VerticalAlignment="Center" />
        <TextBox x:Name="TitleEditTextBox" Grid.Row="0" Grid.Column="1" Text="{Binding Book.Title, Mode=TwoWay}" HorizontalAlignment="Left" Width="300" Margin="5" />

        <Label Grid.Row="1" Grid.Column="0" Target="{Binding ElementName=AuthorEditTextBox}" Content="Author" HorizontalAlignment="Left" VerticalAlignment="Center" />
        <TextBox x:Name="AuthorEditTextBox" Grid.Row="1" Grid.Column="1" Text="{Binding Book.Author, Mode=TwoWay}" HorizontalAlignment="Left" Width="300" Margin="5" />

        <Label Grid.Row="2" Grid.Column="0" Target="{Binding ElementName=YearEditTextBox}" Content="Year" HorizontalAlignment="Left" VerticalAlignment="Center" />
        <TextBox x:Name="YearEditTextBox" Grid.Row="2" Grid.Column="1" Text="{Binding Book.Year, Mode=TwoWay}" HorizontalAlignment="Left" Width="300" Margin="5" />

        <Label Grid.Row="3" Grid.Column="0" Target="{Binding ElementName=GenreEditTextBox}" Content="Genre" HorizontalAlignment="Left" VerticalAlignment="Center" />
        <TextBox x:Name="GenreEditTextBox" Grid.Row="3" Grid.Column="1" Text="{Binding Book.Genre, Mode=TwoWay}" HorizontalAlignment="Left" Width="300" Margin="5" />

        <Label Grid.Row="4" Grid.Column="0" Target="{Binding ElementName=ISBNEditTextBox}" Content="ISBN" HorizontalAlignment="Left" VerticalAlignment="Center" />
        <TextBox x:Name="ISBNEditTextBox" Grid.Row="4" Grid.Column="1" Text="{Binding Book.ISBN, Mode=TwoWay}" HorizontalAlignment="Left" Width="300" Margin="5" />

        <Label Grid.Row="5" Grid.Column="0" Target="{Binding ElementName=PublisherEditTextBox}" Content="Publisher" HorizontalAlignment="Left" VerticalAlignment="Center" />
        <TextBox x:Name="PublisherEditTextBox" Grid.Row="5" Grid.Column="1" Text="{Binding Book.Publisher, Mode=TwoWay}" HorizontalAlignment="Left" Width="300" Margin="5" />

        <Label Grid.Row="6" Grid.Column="0" Target="{Binding ElementName=PagesEditTextBox}" Content="Pages" HorizontalAlignment="Left" VerticalAlignment="Center" />
        <TextBox x:Name="PagesEditTextBox" Grid.Row="6" Grid.Column="1" Text="{Binding Book.Pages, Mode=TwoWay}" HorizontalAlignment="Left" Width="300" Margin="5" />

        <Label Grid.Row="7" Grid.Column="0" Target="{Binding ElementName=PriceEditTextBox}" Content="Price" HorizontalAlignment="Left" VerticalAlignment="Center" />
        <TextBox x:Name="PriceEditTextBox" Grid.Row="7" Grid.Column="1" Text="{Binding Book.Price, Mode=TwoWay}" HorizontalAlignment="Left" Width="300" Margin="5" />

        <Label Grid.Row="8" Grid.Column="0" Target="{Binding ElementName=QuantityInStockEditTextBox}" Content="Quantity In Stock" HorizontalAlignment="Left" VerticalAlignment="Center" />
        <TextBox x:Name="QuantityInStockEditTextBox" Grid.Row="8" Grid.Column="1" Text="{Binding Book.QuantityInStock, Mode=TwoWay}" HorizontalAlignment="Left" Width="300" Margin="5" />

        <StackPanel Grid.Row="9" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Command="{Binding AddOrUpdateBookCommand}" Height="20" Width="80" Margin="5">
                <Button.Style>
                    <Style TargetType="{x:Type Button}">
                        <Setter Property="Content" Value="Update" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding EditMode}" Value="{x:Static viewmodels:EditBookWindowMode.Add}">
                                <Setter Property="Content" Value="Add" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Command="{Binding CancelCommand}" Content="Cancel" Height="20" Width="80" Margin="5" />
        </StackPanel>
    </Grid>
</Window>
